# 使用 Supabase Connect 面板的 PostgreSQL 连接串；密码中的特殊字符需要 URL 编码。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# 可选；未设置时自动在 instance/ 下生成并保存。
# FLASK_SECRET_KEY=replace-with-a-long-random-secret
# HOST=127.0.0.1
PORT=5000
# Bot optional: Render uses RENDER_EXTERNAL_URL automatically; local uses HOST/PORT.
# WEBSITE_URL=https://your-web-service.onrender.com
# DISCORD_TOKEN=your-bot-token
# DISCORD_GUILD_ID=optional-test-server-id
DISCORD_TRADE_CHANNEL_ID=1504352387635216545
# Only the designated recipient receives each notification; never fall back to a public channel.
DISCORD_TRADE_MODE=dm
